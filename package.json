{
  "name": "@wongzexu/dsh-git-status",
  "description": "Git 状态（Git Graph）：commit DAG 泳道图 + 未提交改动虚拟行/stash + 行内详情 diff + 分支操作（checkout/新建）。",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wongzexu/dsh-git-status.git"
  },
  "version": "2.0.0",
  "type": "module",
  "main": "lib/index.mjs",
  "exports": {
    ".": {
      "default": "./lib/index.mjs"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "README_EN.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build-client.js",
    "test": "node --test \"tests/*.test.mjs\"",
    "git-c": "bash scripts/git-cleanup.sh"
  },
  "license": "MIT"
}
